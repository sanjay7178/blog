---
export interface Props {
  tag: string;
  size?: "sm" | "lg";
}

const { tag, size = "sm" } = Astro.props;
---

<li class={`inline-block ${size === "sm" ? "my-1" : "my-2 mr-3"}`}>
  <a
    href={`${import.meta.env.BASE_URL}` + `/tags/${tag}/`}
    transition:name={tag}
    class={`${size === "sm" ? "text-sm" : "text-lg"} group`}
  >
    <span class="tag-hash">#</span>{tag}
  </a>
</li>

<style>
  a {
    @apply text-skin-muted hover:text-skin-accent;
  }
  .tag-hash {
    @apply mr-0.5 text-skin-accent;
  }
</style>
